{
  "info": {
    "_postman_id": "eventos-crud-collection",
    "name": "Eventos API - CRUD",
    "description": "Collection para gerenciar eventos via API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Events",
      "item": [
        {
          "name": "Listar Todos os Eventos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(Array.isArray(jsonData)).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/event/events",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "event",
                "events"
              ]
            },
            "description": "Retorna uma lista de todos os eventos cadastrados"
          },
          "response": []
        },
        {
          "name": "Buscar Evento por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has required fields', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('name');",
                  "    pm.expect(jsonData).to.have.property('draw');",
                  "    pm.expect(jsonData).to.have.property('prefix');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/event/events/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "event",
                "events",
                "1"
              ]
            },
            "description": "Busca um evento específico por seu ID"
          },
          "response": []
        },
        {
          "name": "Criar Novo Evento",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has required fields', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('name');",
                  "    pm.expect(jsonData).to.have.property('draw');",
                  "    pm.expect(jsonData).to.have.property('prefix');",
                  "    pm.expect(jsonData).to.have.property('createdAt');",
                  "    pm.expect(jsonData).to.have.property('updatedAt');",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    pm.environment.set('event_id', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Loteria Nacional\",\n  \"draw\": 500000,\n  \"prefix\": \"LN\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/event/events",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "event",
                "events"
              ]
            },
            "description": "Cria um novo evento com os dados fornecidos"
          },
          "response": []
        },
        {
          "name": "Atualizar Evento",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has updated fields', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('name');",
                  "    pm.expect(jsonData).to.have.property('draw');",
                  "    pm.expect(jsonData).to.have.property('prefix');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Loteria Nacional Atualizada\",\n  \"draw\": 600000,\n  \"prefix\": \"LNA\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/event/events/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "event",
                "events",
                "1"
              ]
            },
            "description": "Atualiza um evento existente com novos dados (todos os campos são opcionais)"
          },
          "response": []
        },
        {
          "name": "Excluir Evento",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has deleted flag', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('deleted', true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/event/events/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "event",
                "events",
                "1"
              ]
            },
            "description": "Exclui um evento existente"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3333",
      "type": "string"
    },
    {
      "key": "event_id",
      "value": "",
      "type": "string"
    }
  ]
}
