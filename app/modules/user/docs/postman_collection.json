{
  "info": {
    "_postman_id": "user-module-collection",
    "name": "User Module API",
    "description": "Coleção de endpoints do módulo User - CRUD de usuários e autenticação",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Usuários",
      "item": [
        {
          "name": "Listar Usuários",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/user/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "users"
              ]
            },
            "description": "Retorna lista de todos os usuários"
          },
          "response": []
        },
        {
          "name": "Obter Usuário por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/user/users/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "users",
                "1"
              ]
            },
            "description": "Retorna um usuário específico pelo ID"
          },
          "response": []
        },
        {
          "name": "Criar Usuário (COM email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Silva\",\n  \"email\": \"joao@example.com\",\n  \"phone\": \"11987654321\",\n  \"password\": \"senha_segura_123\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/user/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "users"
              ]
            },
            "description": "Cria um novo usuário com email fornecido"
          },
          "response": []
        },
        {
          "name": "Criar Usuário (SEM email - auto-gerado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maria Santos\",\n  \"phone\": \"21987654321\",\n  \"password\": \"senha_segura_123\",\n  \"role\": \"vendor\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/user/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "users"
              ]
            },
            "description": "Cria um novo usuário SEM email. Email será gerado automaticamente como {telefone}@showdepremios.cloud"
          },
          "response": []
        },
        {
          "name": "Atualizar Usuário",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Silva Atualizado\",\n  \"phone\": \"11999999999\",\n  \"role\": \"manager\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/user/users/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "users",
                "1"
              ]
            },
            "description": "Atualiza os dados de um usuário existente"
          },
          "response": []
        },
        {
          "name": "Deletar Usuário",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/user/users/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "users",
                "1"
              ]
            },
            "description": "Deleta um usuário existente"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login (por Email)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"joao@example.com\",\n  \"password\": \"senha_segura_123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/user/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "login"
              ]
            },
            "description": "Realiza login com email e senha, retornando um token de autenticação"
          },
          "response": []
        },
        {
          "name": "Login (por Telefone)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"11987654321\",\n  \"password\": \"senha_segura_123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/user/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user",
                "login"
              ]
            },
            "description": "Realiza login com telefone e senha, retornando um token de autenticação"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3333",
      "type": "string"
    }
  ]
}
